{
  "type": "record",
  "name": "MovieEvent",
  "namespace": "cinema.events",
  "doc": "Действие пользователя онлайн-кинотеатра. Топик movie-events, ключ сообщения = user_id.",
  "fields": [
    {
      "name": "event_id",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "Уникальный идентификатор события (UUID). Повтор с тем же event_id — дубль, ClickHouse его схлопывает."
    },
    { "name": "user_id", "type": "string", "doc": "Идентификатор пользователя" },
    { "name": "movie_id", "type": "string", "doc": "Идентификатор фильма (для SEARCHED — фильм, выбранный в результатах поиска)" },
    {
      "name": "event_type",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": ["VIEW_STARTED", "VIEW_FINISHED", "VIEW_PAUSED", "VIEW_RESUMED", "LIKED", "SEARCHED"]
      }
    },
    {
      "name": "timestamp",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "Время события в UTC, миллисекунды от epoch"
    },
    {
      "name": "device_type",
      "type": { "type": "enum", "name": "DeviceType", "symbols": ["MOBILE", "DESKTOP", "TV", "TABLET"] }
    },
    { "name": "session_id", "type": "string", "doc": "Идентификатор сессии просмотра" },
    {
      "name": "progress_seconds",
      "type": ["null", "int"],
      "default": null,
      "doc": "Прогресс просмотра в секундах. Обязателен для VIEW_*, для LIKED/SEARCHED может быть null"
    }
  ]
}
