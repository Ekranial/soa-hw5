    {
      "type": "table",
      "title": "Retention Cohort Heatmap",
      "description": "Когорта — день первого просмотра (VIEW_STARTED). Day N — % пользователей когорты, у которых было любое событие через N дней. Источник: агрегат agg_retention_cohort.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toString(cohort_date) AS \"Когорта\", any(cohort_size) AS \"Пользователей\", maxIfOrNull(retention_pct, day_number = 0) AS \"Day 0\", maxIfOrNull(retention_pct, day_number = 1) AS \"Day 1\", maxIfOrNull(retention_pct, day_number = 2) AS \"Day 2\", maxIfOrNull(retention_pct, day_number = 3) AS \"Day 3\", maxIfOrNull(retention_pct, day_number = 4) AS \"Day 4\", maxIfOrNull(retention_pct, day_number = 5) AS \"Day 5\", maxIfOrNull(retention_pct, day_number = 6) AS \"Day 6\", maxIfOrNull(retention_pct, day_number = 7) AS \"Day 7\" FROM analytics.agg_retention_cohort FINAL WHERE cohort_date BETWEEN toDate($__fromTime) AND toDate($__toTime) GROUP BY cohort_date ORDER BY cohort_date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "continuous-RdYlGr"
          },
