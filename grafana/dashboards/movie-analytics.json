    {
      "type": "timeseries",
      "title": "Конверсия просмотра и Retention D1 / D7",
      "description": "Конверсия — по дате события; Retention D1/D7 — по дате когорты (дню первого просмотра)",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toDateTime(metric_date) AS time, maxIfOrNull(value, metric_name = 'view_conversion') AS \"Конверсия просмотра\", maxIfOrNull(value, metric_name = 'retention_d1') AS \"Retention D1\", maxIfOrNull(value, metric_name = 'retention_d7') AS \"Retention D7\" FROM analytics.agg_daily_metrics FINAL WHERE metric_name IN ('view_conversion', 'retention_d1', 'retention_d7') AND metric_date BETWEEN toDate($__fromTime) AND toDate($__toTime) GROUP BY metric_date ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
